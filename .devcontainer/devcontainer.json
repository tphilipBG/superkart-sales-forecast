{
  "name": "SuperKart deployment",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [7860, 8501],
  "portsAttributes": {
    "7860": {"label": "Flask backend"},
    "8501": {"label": "Streamlit frontend"}
  },
  "postStartCommand": "setsid nohup bash deploy/run_demo.sh > /tmp/run_demo.log 2>&1 < /dev/null &"
}
